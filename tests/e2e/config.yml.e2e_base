log:
  # The directory to save the log files
  dir: "logs"

  # Log level could be "DEBUG", "INFO", "WARNING", "ERROR"
  level: "INFO"

task_error_report:
  automatic: false

ethereum:
  # Keep online chain for e2e integration
  provider: "https://json-rpc.base-sepolia.crynux.io"
  network: "crynux-on-base-sepolia"

  # Blockchain parameters
  gas_price: 700000000
  gas: 8000000

  contract:
    benefit_address: "0x195FeF730936C4B68BFF9F98429037ba68e82414"
    node_staking: "0x3EB72d01bd77a36ABB867eafFD6BaECE8252Ce32"
    delegated_staking: "0xC3C9CC3ce811Bd825118f2E36524716F86923f81"

# The database used to store the local state data
db:
  # The database driver, can only be sqlite now
  driver: sqlite
  # The sqlite database file
  filename: db/server.db

# The URL of the Relay
relay_url: "http://crynux_relay:8080"

# The directory that stores the distribution files of the WebUI
web_dist: dist

# The resource dir for icons etc.
resource_dir: res

task_config:
  # Models that will be preloaded before any task execution
  preloaded_models:
    sd_base:
      - id: "qwen/qwen-image-2.1"
    gpt_base:
      - id: "qwen/qwen3-8b"
    controlnet: []
    lora: []

  # The proxy server used when downloading models
  proxy:
    host: ""
    port: 33210

  # URL of repository stores patch files of crynux worker
  worker_patch_url: https://raw.githubusercontent.com/crynux-network/crynux-worker/main

  # Tensor parallel fallback when model dims are not divisible by GPU count
  # device_map: classic layer sharding; reduce_gpus: use fewer GPUs that divide
  tp_fallback: device_map
